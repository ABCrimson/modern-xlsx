{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "types": ["node"],
    "paths": {
      "#runtime": ["./src/runtime-node.ts"],
      "modern-xlsx": ["./src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "__tests__/**/*.ts"],
  "exclude": ["node_modules", "dist", "wasm", "wasm-lite"]
}
