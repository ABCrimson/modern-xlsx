{
  "name": "modern-xlsx",
  "version": "1.2.0",
  "description": "High-performance XLSX read/write library powered by Rust WASM. Full styling, encryption, data validation, conditional formatting — features SheetJS charges for, free and open source.",
  "license": "MIT",
  "author": "modern-xlsx contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/ABCrimson/modern-xlsx"
  },
  "homepage": "https://github.com/ABCrimson/modern-xlsx#readme",
  "keywords": [
    "xlsx",
    "excel",
    "spreadsheet",
    "wasm",
    "rust",
    "ooxml",
    "styles",
    "formatting",
    "data-validation",
    "conditional-formatting",
    "encryption",
    "password-protected",
    "ole2",
    "pivot-tables",
    "threaded-comments",
    "slicers",
    "timelines",
    "charts",
    "cli"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./lite": {
      "types": "./dist/index-lite.d.mts",
      "import": "./dist/index-lite.mjs",
      "default": "./dist/index-lite.mjs"
    },
    "./browser": "./dist/modern-xlsx.min.js",
    "./worker": "./dist/modern-xlsx.worker.js"
  },
  "unpkg": "./dist/modern-xlsx.min.js",
  "jsdelivr": "./dist/modern-xlsx.min.js",
  "files": [
    "dist/",
    "wasm/",
    "wasm-lite/",
    "LICENSE",
    "README.md"
  ],
  "bin": {
    "modern-xlsx": "./dist/cli.mjs"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsdown && node scripts/finalize-dist.mjs",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:watch": "vitest",
    "lint": "biome check src/ __tests__/",
    "typecheck": "tsc --noEmit",
    "docs:api": "npx -y typedoc@0.28.20",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@types/node": "26.4.0",
    "@vitest/browser": "5.0.0-rc.2",
    "@vitest/browser-playwright": "5.0.0-rc.2",
    "@vitest/coverage-v8": "5.0.0-rc.2",
    "playwright": "1.63.0-alpha-2026-08-27",
    "tsdown": "0.23.0-rc.0",
    "typescript": "7.0.2",
    "vitest": "5.0.0-rc.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
