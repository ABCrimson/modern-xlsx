{
  "name": "modern-xlsx",
  "version": "1.3.0",
  "description": "Read, write, style and encrypt Excel .xlsx files in JavaScript and TypeScript. Charts, pivot tables, formulas and streaming writes from a Rust core compiled to WebAssembly. MIT, zero dependencies.",
  "license": "MIT",
  "author": "Albert Badalov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ABCrimson/modern-xlsx.git",
    "directory": "packages/modern-xlsx"
  },
  "homepage": "https://abcrimson.github.io/modern-xlsx/",
  "bugs": {
    "url": "https://github.com/ABCrimson/modern-xlsx/issues"
  },
  "keywords": [
    "excel",
    "xlsx",
    "spreadsheet",
    "workbook",
    "xlsx-parser",
    "xlsx-writer",
    "ooxml",
    "typescript",
    "wasm",
    "webassembly",
    "rust",
    "charts",
    "pivot-table",
    "formulas",
    "conditional-formatting",
    "data-validation",
    "streaming",
    "encryption",
    "password-protected",
    "browser",
    "deno",
    "bun",
    "cloudflare-workers",
    "exceljs-alternative",
    "sheetjs-alternative"
  ],
  "type": "module",
  "imports": {
    "#runtime": {
      "node": "./dist/runtime-node.mjs",
      "default": "./dist/runtime-browser.mjs"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./lite": {
      "types": "./dist/index-lite.d.mts",
      "import": "./dist/index-lite.mjs",
      "default": "./dist/index-lite.mjs"
    },
    "./browser": {
      "types": "./dist/modern-xlsx.min.d.ts",
      "default": "./dist/modern-xlsx.min.js"
    },
    "./worker": {
      "types": "./dist/modern-xlsx.worker.d.ts",
      "default": "./dist/modern-xlsx.worker.js"
    },
    "./wasm": {
      "types": "./dist/wasm-module.d.ts",
      "default": "./wasm/modern_xlsx_wasm_bg.wasm"
    }
  },
  "unpkg": "./dist/modern-xlsx.min.js",
  "jsdelivr": "./dist/modern-xlsx.min.js",
  "files": [
    "dist/",
    "wasm/",
    "wasm-lite/",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "bin": {
    "modern-xlsx": "dist/cli.mjs"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsdown && node scripts/finalize-dist.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "bench": "pnpm run build && vitest bench --run --reporter=verbose",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:watch": "vitest",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "docs:api": "npx -y -p typescript@6.0.3 -p typedoc@0.28.20 typedoc",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@biomejs/biome": "2.6.7",
    "@types/node": "26.6.6",
    "@vitest/browser": "5.1.0",
    "@vitest/browser-playwright": "5.1.0",
    "@vitest/coverage-v8": "5.1.0",
    "playwright": "1.66.0-alpha-2026-11-14",
    "publint": "0.3.25",
    "tsdown": "0.23.7",
    "typescript": "7.1.0-dev.20261114.1",
    "vitest": "5.1.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
