{
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "build:wasm": "cd crates/modern-xlsx-wasm && wasm-pack build --target web --release --out-dir ../../packages/modern-xlsx/wasm -- --config \"profile.release.trim-paths='all'\"",
    "build:wasm:lite": "cd crates/modern-xlsx-wasm && wasm-pack build --target web --release --out-dir ../../packages/modern-xlsx/wasm-lite -- --no-default-features --config \"profile.release.trim-paths='all'\"",
    "build:wasm:debug": "cd crates/modern-xlsx-wasm && wasm-pack build --dev --target web --out-dir ../../packages/modern-xlsx/wasm",
    "build:ts": "pnpm -C packages/modern-xlsx build",
    "build": "pnpm build:wasm && pnpm build:wasm:lite && pnpm build:ts",
    "test:rust": "cargo test --workspace",
    "test:ts": "pnpm -C packages/modern-xlsx test",
    "test": "pnpm test:rust && pnpm test:ts",
    "lint": "biome check .",
    "fmt": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7"
  }
}
